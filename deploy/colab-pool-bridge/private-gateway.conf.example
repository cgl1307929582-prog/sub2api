# Bind only the Docker bridge gateway. Substitute the actual gateway and subnet.
# Do not bind this listener to 0.0.0.0 or a public address.
server {
    listen 172.21.0.1:18903;
    server_name _;
    allow 172.21.0.0/16;
    deny all;
    access_log off;
    client_max_body_size 50m;

    location = /control/telemetry {
        proxy_pass http://127.0.0.1:18901/api/telemetry;
        proxy_set_header X-Internal-Auth $http_x_internal_auth;
        proxy_read_timeout 15s;
    }
    location /control/ {
        proxy_pass http://127.0.0.1:18900/api/;
        proxy_set_header X-Internal-Auth $http_x_internal_auth;
        proxy_read_timeout 95s;
    }
    location /v1/ {
        proxy_pass http://127.0.0.1:18902;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
    location / { return 404; }
}
